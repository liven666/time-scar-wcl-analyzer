# Create an OAuth client at https://www.warcraftlogs.com/api/clients and keep
# the secret on the server. Never expose WCL_CLIENT_SECRET in browser code.
WCL_CLIENT_ID=
WCL_CLIENT_SECRET=

# Optional overrides. The defaults point at the official public API.
# WCL_OAUTH_URL=https://www.warcraftlogs.com/oauth/token
# WCL_API_URL=https://www.warcraftlogs.com/api/v2/client
